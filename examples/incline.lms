# Two identical blocks on a 30 degree ramp, friction 0.3 and 0.7. tan(30) = 0.577: the first slides with
# a = g (sin - mu cos), the second sticks. The same experiment runs with the penalty (SMC) formulation.
out = ARGV.len() > 0 ? ARGV[0] : "build/incline.dslb";
mkdir("build/examples");
mkdir("images");
p = _lmcode_ cli="lmphysics" install="github:lmctl-ai/lmphysics@latest";
let th = 0.5235987755982988;
let slide = phys.system("nsc");
slide.material("m", 0.3, 0.0).timestep(0.001);
slide.box("ramp", 40.0, 4.0, 0.5, 1000.0).rot_axis(0.0, 1.0, 0.0, th).fixed(true).collide("m");
let a = slide.box("a", 0.4, 0.4, 0.4, 500.0).pos(0.45 * sin(th), 0.0, 0.45 * cos(th)).rot_axis(0.0, 1.0, 0.0, th).collide("m");
slide.record("a", "x,z,vx,vz");
slide.run(1.5);
phys.assert_close(a.vx() * cos(th) - a.vz() * sin(th), 9.81 * (sin(th) - 0.3 * cos(th)) * 1.5, 0.03);
slide.save_csv("build/examples/incline_slides.csv");
let stick = phys.system("smc");
stick.material("m", 0.7, 0.0).timestep(0.001);
stick.box("ramp", 40.0, 4.0, 0.5, 1000.0).rot_axis(0.0, 1.0, 0.0, th).fixed(true).collide("m");
let b = stick.box("b", 0.4, 0.4, 0.4, 500.0).pos(0.45 * sin(th), 0.0, 0.45 * cos(th)).rot_axis(0.0, 1.0, 0.0, th).collide("m");
stick.record("b", "x,z,speed");
stick.run(1.5);
phys.assert_close(b.speed(), 0.0, 0.05);
stick.save_csv("build/examples/incline_sticks.csv");
end _lmcode_
savedsl(p, out);
r = system ${dsl_cli(p)} --lmcode ${out};
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/incline.png", 900, 520);
plot.cmd("set datafile separator ','");
plot.cmd("set title 'Block on a 30 degree ramp: speed along the slope for friction 0.3 (slides) and 0.7 (sticks)'");
plot.cmd("set grid");
plot.cmd("set xlabel 'time [s]'");
plot.cmd("set ylabel 'speed along the slope [m/s]'");
plot.cmd("set key top left box opaque");
plot.cmd("th = 0.5235987755982988");
plot.cmd("plot 'build/examples/incline_slides.csv' skip 1 using 1:($4*cos(th)-$5*sin(th)) with lines lw 3 lc rgb '#1f77b4' title 'mu = 0.3, NSC', 9.81*(sin(th)-0.3*cos(th))*x with lines dt 2 lw 2 lc rgb 'black' title 'g (sin - mu cos) t', 'build/examples/incline_sticks.csv' skip 1 using 1:4 with lines lw 3 lc rgb '#d62728' title 'mu = 0.7, SMC (sticks)'");
plot.close();
end _lmcode_
savedsl(draw, "build/incline-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode build/incline-draw.dslb;
assert(r.code == 0);
println("wrote images/incline.png");
