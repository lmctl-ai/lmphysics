# Pouring 40 balls into a box: lmphysics (NSC contact, friction 0.3, APGD solver) drops a 4 x 5 x 2 stack of spheres into
# a walled container and lets it settle for 2.5 s; the script turns the final positions into a keyframe file (one row per
# ball, coloured by height) and lmcad renders the heap with its software renderer. Same pipeline for any pile of spheres.
# Output: images/pour.png   (run: lmctl autorun <raw url of this file>)
mkdir("build/examples");
mkdir("images");
sim = _lmcode_ cli="lmphysics" install="github:lmctl-ai/lmphysics@latest";
let s = phys.system("nsc");
s.material("glass", 0.3, 0.1).timestep(0.004).solver("apgd", 30).record_every(250);
s.floor("floor", "glass");
s.box("w1", 0.1, 1.2, 1.5, 1000.0).pos(0.55, 0.0, 0.75).fixed(true).collide("glass");
s.box("w2", 0.1, 1.2, 1.5, 1000.0).pos(-0.55, 0.0, 0.75).fixed(true).collide("glass");
s.box("w3", 1.0, 0.1, 1.5, 1000.0).pos(0.0, 0.55, 0.75).fixed(true).collide("glass");
s.box("w4", 1.0, 0.1, 1.5, 1000.0).pos(0.0, -0.55, 0.75).fixed(true).collide("glass");
for (k in range(0, 40)) {
  let ix = k % 4;
  let iy = (k / 4) % 4;
  let iz = k / 16;
  let b = s.sphere("s" + str(k), 0.08, 500.0).pos(0.2 * float(ix) - 0.3 + 0.01 * float(iz), 0.2 * float(iy) - 0.3, 0.3 + 0.2 * float(iz)).collide("glass");
  s.record("s" + str(k), "x,y,z");
}
s.run(2.5);
s.save_csv("build/examples/pour.csv");
end _lmcode_
savedsl(sim, "build/viz_pour-sim.dslb");
r = system ${dsl_cli(sim)} --dsl build/viz_pour-sim.dslb;
assert(r.code == 0);

# Last CSV row -> lmcad keyframe file (t,x,y,z,r,g,b): one row per ball, lmcad's y axis is up.
rows = csv_parse(read_file("build/examples/pour.csv"));
last = rows.get(rows.len() - 1, null);
kf = "t,x,y,z,r,g,b\n";
for (k in range(0, 40)) {
  zc = last.get("s" + str(k) + ".z", 0.0);
  h = (zc - 0.08) / 0.14;
  if (h > 1.0) { h = 1.0; }
  if (h < 0.0) { h = 0.0; }
  kf = kf + sprintf("%d,%.4f,%.4f,%.4f,%.3f,%.3f,%.3f\n", k, last.get("s" + str(k) + ".x", 0.0), zc, last.get("s" + str(k) + ".y", 0.0), 0.15 + 0.8 * h, 0.45 + 0.1 * h, 0.9 - 0.75 * h);
}
write_file("build/examples/pour_keys.csv", kf);

draw = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
let keys = read_keyframes_csv("build/examples/pour_keys.csv");
scene.background(0.06, 0.07, 0.10);
let slab = material().color(0.55, 0.58, 0.62).roughness(0.8);
scene.box(1.4, 0.04, 1.4, slab).translate(0.0, -0.02, 0.0);
let wall = material().color(0.35, 0.40, 0.48).specular(0.2);
scene.box(0.1, 0.5, 1.2, wall).translate(0.55, 0.25, 0.0);
scene.box(0.1, 0.5, 1.2, wall).translate(-0.55, 0.25, 0.0);
scene.box(1.0, 0.5, 0.1, wall).translate(0.0, 0.25, -0.55);
for (i in range(0, keys.len())) {
  let key = keys.at(i);
  let mat = material().color(key.r(), key.g(), key.b()).specular(0.6).shininess(60.0);
  scene.sphere(0.08, mat).translate(key.x(), key.y(), key.z());
}
scene.camera(34.0, 1.2, 1.35, 1.75, 0.0, 0.05, 0.0);
scene.directional_light(-0.5, -1.0, -0.4, 0.8);
scene.fill_light(0.8, -0.2, 0.9, 0.35);
scene.ambient(0.22);
scene.supersample(2);
scene.render_png("images/pour.png", 900, 600);
end _lmcode_
savedsl(draw, "build/viz_pour-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/viz_pour-draw.dslb;
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
println("wrote images/pour.png");
