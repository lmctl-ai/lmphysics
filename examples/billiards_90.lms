# The pool player's 90-degree rule: when a cue ball hits a resting ball of the same mass off-centre (elastic, no
# friction, no spin), the two leave at right angles. Momentum and energy conservation give v_A . v_B = 0, whatever
# the cut. The object ball runs along the line of centres at the cut angle asin(b / 2r). lmphysics fires a 5.7 cm
# ball at 2 m/s past a resting one at five offsets b (zero gravity, restitution 1, zero collision margins); the
# script checks the angle and the speed split v cos(theta), v sin(theta), and lmdraw draws the paths.
# Output: images/billiards_90.png   (run: lmctl autorun <raw url of this file>)
mkdir("build/examples");
mkdir("build/rendered");
mkdir("images");
sim = _lmcode_ cli="lmphysics" install="github:lmctl-ai/lmphysics@latest";
let r = 0.0285;
for (k in range(0, 5)) {
  let b = 2.0 * r * (0.15 + 0.175 * float(k));
  let s = phys.system("nsc");
  s.gravity(0.0, 0.0, 0.0).material("ivory", 0.0, 1.0).timestep(0.0001).collision_margins(0.0, 0.0).bounce_speed(0.01).record_every(20);
  let cue = s.sphere("cue", r, 1700.0).pos(-0.3, b, 0.0).vel(2.0, 0.0, 0.0).collide("ivory");
  let obj = s.sphere("obj", r, 1700.0).collide("ivory");
  s.record("cue", "x,y,vx,vy").record("obj", "x,y,vx,vy");
  s.run(0.235);
  let dot = cue.vx() * obj.vx() + cue.vy() * obj.vy();
  phys.assert_close(dot / 4.0, 0.0, 0.002);
  phys.assert_close(cue.vx() * cue.vx() + cue.vy() * cue.vy() + obj.vx() * obj.vx() + obj.vy() * obj.vy(), 4.0, 0.01);
  # Object ball speed v sin(theta)... its direction is the line of centres: sin(cut) = b / 2r.
  phys.assert_close(obj.vy() / sqrt(obj.vx() * obj.vx() + obj.vy() * obj.vy()), -b / (2.0 * r), 0.005);
  s.save_csv("build/examples/billiards_" + str(k) + ".csv");
}
end _lmcode_
savedsl(sim, "build/billiards_90-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode build/billiards_90-sim.dslb;
if (r.code != 0) { println(r.stdout); println(r.stderr); }
assert(r.code == 0);

# Pixels: 1000 per metre; the object ball rests at (400, 250), y up on the table = up on the screen.
fn px(x) { return 400.0 + 1000.0 * x; }
fn py(y) { return 250.0 - 1000.0 * y; }
cols = ["#ff6b6b", "#ffd166", "#7bd88f", "#4fa3ff", "#c792ea"];
paths = [];
tbl = "";
for (k in range(0, 5)) {
  let rows = csv_parse(read_file("build/examples/billiards_" + str(k) + ".csv"));
  let pc = ""; let po = "";
  for (row in rows) {
    pc = pc + sprintf("%.1f,%.1f ", px(num(row["cue.x"])), py(num(row["cue.y"])));
    po = po + sprintf("%.1f,%.1f ", px(num(row["obj.x"])), py(num(row["obj.y"])));
  }
  let last = rows[rows.len() - 1];
  let ax = num(last["cue.vx"]); let ay = num(last["cue.vy"]); let bx = num(last["obj.vx"]); let by = num(last["obj.vy"]);
  let cosang = (ax * bx + ay * by) / sqrt((ax * ax + ay * ay) * (bx * bx + by * by));
  tbl = tbl + sprintf("b = %.2f x 2r:  cue %.2f m/s, object %.2f m/s,  cos(angle between) = %.4f\n", 0.15 + 0.175 * k, sqrt(ax * ax + ay * ay), sqrt(bx * bx + by * by), cosang);
  push(paths, [pc, po]);
}
c0 = paths[0][0]; o0 = paths[0][1];
c1 = paths[1][0]; o1 = paths[1][1];
c2 = paths[2][0]; o2 = paths[2][1];
c3 = paths[3][0]; o3 = paths[3][1];
c4 = paths[4][0]; o4 = paths[4][1];
lines = split(trim(tbl), "\n");
l0 = lines[0]; l1 = lines[1]; l2 = lines[2]; l3 = lines[3]; l4 = lines[4];
println(tbl);
# Ghost of the cue ball at impact for the middle case, b = r: centres 2r apart.
gx = px(-sqrt(4.0 * 0.0285 * 0.0285 - 0.0285 * 0.0285));
gy = py(0.0285);

d = _lmcode_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900, 640, "#0d3b2e");
scene.text(40.0, 44.0, 24.0, "Billiards: equal balls always part at 90 degrees", "#f1f5ef").set_attr("font-weight", "700");
scene.text(40.0, 72.0, 14.0, "Cue ball from the left at 2 m/s, five offsets b. Dashed: cue ball; solid: object ball. Simulated by lmphysics.", "#bfe3cf");
scene.polyline(${c0}, "#ff6b6b", 2.0).set_attr("stroke-dasharray", "7 5");
scene.polyline(${c1}, "#ffd166", 2.0).set_attr("stroke-dasharray", "7 5");
scene.polyline(${c2}, "#7bd88f", 2.0).set_attr("stroke-dasharray", "7 5");
scene.polyline(${c3}, "#4fa3ff", 2.0).set_attr("stroke-dasharray", "7 5");
scene.polyline(${c4}, "#c792ea", 2.0).set_attr("stroke-dasharray", "7 5");
scene.polyline(${o0}, "#ff6b6b", 3.0);
scene.polyline(${o1}, "#ffd166", 3.0);
scene.polyline(${o2}, "#7bd88f", 3.0);
scene.polyline(${o3}, "#4fa3ff", 3.0);
scene.polyline(${o4}, "#c792ea", 3.0);
scene.circle(400.0, 250.0, 28.5, "#f6f1e3");
scene.circle(${gx}, ${gy}, 28.5, "none").set_attr("stroke", "#7bd88f").set_attr("stroke-width", "2");
scene.text(440.0, 220.0, 14.0, "object ball at rest", "#f1f5ef");
scene.text(${gx} - 130.0, ${gy} + 50.0, 13.0, "cue ball at impact (b = r)", "#7bd88f");
scene.text(40.0, 500.0, 14.0, ${l0}, "#ff6b6b");
scene.text(40.0, 522.0, 14.0, ${l1}, "#ffd166");
scene.text(40.0, 544.0, 14.0, ${l2}, "#7bd88f");
scene.text(40.0, 566.0, 14.0, ${l3}, "#4fa3ff");
scene.text(40.0, 588.0, 14.0, ${l4}, "#c792ea");
scene.text(40.0, 616.0, 13.0, "cos = 0 means a right angle; the two speeds are v cos(cut) and v sin(cut), so kinetic energy is kept.", "#bfe3cf");
scene.render_png("build/rendered/billiards_90.png", 900, 640, 1);
end _lmcode_
savedsl(d, "build/billiards_90-draw.dslb");
r = system ${dsl_cli(d)} --lmcode build/billiards_90-draw.dslb;
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
copy_file("build/rendered/billiards_90.png", "images/billiards_90.png");
println("wrote images/billiards_90.png");
