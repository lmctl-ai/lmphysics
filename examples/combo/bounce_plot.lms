# Two hosts in one script: lmphysics simulates a bouncing ball and writes a CSV, lmplot draws it.
# Needs lmplot on PATH or installable; the PNG lands in build/examples/bounce.png.
mkdir("build/examples");
sim = _dsl_ cli="lmphysics" install="github:lmctl-ai/lmphysics@latest";
let s = phys.system("nsc");
s.material("rubber", 0.3, 0.8).timestep(0.001);
s.floor("floor", "rubber");
let ball = s.sphere("ball", 0.1, 500.0).pos(0.0, 0.0, 2.1).vel(1.5, 0.0, 0.0).collide("rubber");
s.record("ball", "x,z");
s.run(4.0);
s.save_csv("build/examples/bounce.csv");
end _dsl_
savedsl(sim, "build/bounce-sim.dslb");
r = system ${dsl_cli(sim)} --dsl build/bounce-sim.dslb;
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("build/examples/bounce.png", 900, 500);
plot.cmd("set title 'Bouncing ball, restitution 0.8 (lmphysics / Chrono, drawn by lmplot)'");
plot.cmd("set datafile separator ','");
plot.cmd("set key autotitle columnhead");
plot.cmd("set xlabel 'x [m]'");
plot.cmd("set ylabel 'height [m]'");
plot.cmd("unset key");
plot.cmd("plot 'build/examples/bounce.csv' using 2:3 with lines lw 2 lc rgb '#1f77b4'");
plot.close();
end _dsl_
savedsl(draw, "build/bounce-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/bounce-draw.dslb;
assert(r.code == 0);
println("wrote build/examples/bounce.png");
