# Ball dropped on a floor, restitution 0.8 (NSC contact). Chrono applies the rebound one step late, so each apex is
# a factor between e^4 = 0.41 and e^2 = 0.64 of the previous one, depending on the impact phase within the step.
out = ARGV.len() > 0 ? ARGV[0] : "build/bouncing_ball.dslb";
mkdir("build/examples");
mkdir("images");
p = _dsl_ cli="lmphysics" install="github:lmctl-ai/lmphysics@latest";
let s = phys.system("nsc");
s.material("rubber", 0.3, 0.8).timestep(0.001);
s.floor("floor", "rubber");
let ball = s.sphere("ball", 0.1, 500.0).pos(0.0, 0.0, 2.1).collide("rubber");
s.record("ball", "z,vz");
let vprev = ball.vz();
let apex = 2.0;
let n = 0;
let steps = 0;
while (n < 3 && steps < 20000) {
  s.step();
  steps = steps + 1;
  if (vprev > 0.0 && ball.vz() <= 0.0) {
    n = n + 1;
    phys.assert_close(ball.z() - 0.1, apex * 0.525, apex * 0.125 + 0.005);
    apex = ball.z() - 0.1;
  }
  vprev = ball.vz();
}
phys.assert_close(float(n), 3.0, 0.0);
s.save_csv("build/examples/bouncing_ball.csv");
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/bouncing_ball.png", 900, 520);
plot.cmd("set datafile separator ','");
plot.cmd("set title 'Ball dropped from 2 m, restitution 0.8 (Chrono NSC contact)'");
plot.cmd("set grid");
plot.cmd("set xlabel 'time [s]'");
plot.cmd("set ylabel 'height of the ball centre [m]'");
plot.cmd("unset key");
plot.cmd("plot 'build/examples/bouncing_ball.csv' skip 1 using 1:2 with lines lw 2 lc rgb '#1f77b4'");
plot.close();
end _dsl_
savedsl(draw, "build/bouncing_ball-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/bouncing_ball-draw.dslb;
assert(r.code == 0);
println("wrote images/bouncing_ball.png");
