# Contact: restitution (NSC), sliding and sticking on an incline (NSC and SMC), settling at rest.
out = ARGV.len() > 0 ? ARGV[0] : "build/contact.dslb";
p = _dsl_ cli="lmphysics";
# Ball dropped from 1.0 m above the floor with restitution 0.8. The Newton restitution model is applied one step
# late, so the effective coefficient lies in [e^2, e] and each apex is a factor in [e^4, e^2] = [0.4096, 0.64] of the
# previous height, depending on the impact phase within the step.
let a = phys.system("nsc");
a.material("rubber", 0.3, 0.8).timestep(0.001);
a.floor("floor", "rubber");
let ball = a.sphere("ball", 0.1, 500.0).pos(0.0, 0.0, 1.1).collide("rubber");
let vprev = ball.vz();
let bounces = 0;
let steps = 0;
let apex1 = 0.0;
let apex2 = 0.0;
while (bounces < 2 && steps < 20000) {
  a.step();
  steps = steps + 1;
  if (vprev > 0.0 && ball.vz() <= 0.0) {
    bounces = bounces + 1;
    if (bounces == 1) { apex1 = ball.z() - 0.1; } else { apex2 = ball.z() - 0.1; }
  }
  vprev = ball.vz();
}
phys.assert_close(float(bounces), 2.0, 0.0);
phys.assert_close(apex1, 0.525, 0.125);
phys.assert_close(apex2, apex1 * 0.525, apex1 * 0.125 + 0.01);
# A perfectly inelastic ball (e = 0) stops at the floor: it ends at rest with its radius above z = 0.
let b = phys.system("nsc");
b.material("clay", 0.5, 0.0).timestep(0.001);
b.floor("floor", "clay");
let lump = b.sphere("lump", 0.1, 500.0).pos(0.0, 0.0, 0.5).collide("clay");
b.run(2.0);
phys.assert_close(lump.z(), 0.1, 0.002);
phys.assert_close(lump.vz(), 0.0, 0.01);
phys.assert_close(float(b.contacts()), 1.0, 0.0);
# Block on a 30 degree incline (box rotated about y). Sliding iff tan(theta) > mu, a = g (sin - mu cos).
let th = 0.5235987755982988;
let n = phys.system("nsc");
n.material("m", 0.3, 0.0).timestep(0.001);
n.box("ramp", 40.0, 4.0, 0.5, 1000.0).rot_axis(0.0, 1.0, 0.0, th).fixed(true).collide("m");
let blk = n.box("blk", 0.4, 0.4, 0.4, 500.0).pos(0.45 * sin(th), 0.0, 0.45 * cos(th)).rot_axis(0.0, 1.0, 0.0, th).collide("m");
n.run(1.0);
phys.assert_close(blk.vx() * cos(th) - blk.vz() * sin(th), 9.81 * (sin(th) - 0.3 * cos(th)), 0.01);
let st = phys.system("nsc");
st.material("m", 0.7, 0.0).timestep(0.001);
st.box("ramp", 40.0, 4.0, 0.5, 1000.0).rot_axis(0.0, 1.0, 0.0, th).fixed(true).collide("m");
let stuck = st.box("blk", 0.4, 0.4, 0.4, 500.0).pos(0.45 * sin(th), 0.0, 0.45 * cos(th)).rot_axis(0.0, 1.0, 0.0, th).collide("m");
st.run(1.0);
phys.assert_close(stuck.speed(), 0.0, 0.01);                    # tan 30 = 0.577 < mu = 0.7: it sticks
# Same two experiments with the penalty (SMC) formulation.
let sm = phys.system("smc");
sm.material("m", 0.3, 0.0).timestep(0.001);
sm.box("ramp", 40.0, 4.0, 0.5, 1000.0).rot_axis(0.0, 1.0, 0.0, th).fixed(true).collide("m");
let slid = sm.box("blk", 0.4, 0.4, 0.4, 500.0).pos(0.45 * sin(th), 0.0, 0.45 * cos(th)).rot_axis(0.0, 1.0, 0.0, th).collide("m");
sm.run(1.0);
phys.assert_close(slid.vx() * cos(th) - slid.vz() * sin(th), 9.81 * (sin(th) - 0.3 * cos(th)), 0.02);
let ss = phys.system("smc");
ss.material("m", 0.7, 0.0).timestep(0.001);
ss.box("ramp", 40.0, 4.0, 0.5, 1000.0).rot_axis(0.0, 1.0, 0.0, th).fixed(true).collide("m");
let held = ss.box("blk", 0.4, 0.4, 0.4, 500.0).pos(0.45 * sin(th), 0.0, 0.45 * cos(th)).rot_axis(0.0, 1.0, 0.0, th).collide("m");
ss.run(1.0);
phys.assert_close(held.speed(), 0.0, 0.05);
# SMC ball resting on the floor: penetration is small but non-zero and the ball ends at rest.
let sp = phys.system("smc");
sp.material("hard", 0.3, 0.2).stiffness("hard", 100000000.0, 0.3).timestep(0.0001);
sp.floor("floor", "hard");
let rest = sp.sphere("rest", 0.1, 500.0).pos(0.0, 0.0, 0.1005).collide("hard");
sp.run(0.5);
phys.assert_close(rest.z(), 0.1, 0.002);
phys.assert_close(rest.vz(), 0.0, 0.05);
end _dsl_
savedsl(p, out);
