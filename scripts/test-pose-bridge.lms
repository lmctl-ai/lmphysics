import "../examples/bridge/pose_obj.lms";
row = {"b.x":1.0,"b.y":2.0,"b.z":3.0,"b.qw":1.0,"b.qx":0.0,"b.qy":0.0,"b.qz":0.0};
# Negative modes are invoked separately by test.sh and must exit with an error.
if (ARGV.len()>0) {
  if (ARGV[0]=="missing") { pose_point({},"b",[0.0,0.0,0.0]); }
  if (ARGV[0]=="zero") { row["b.qw"]=0.0; pose_point(row,"b",[0.0,0.0,0.0]); }
  if (ARGV[0]=="oversized") { row["b.x"]=1000001.0; pose_point(row,"b",[0.0,0.0,0.0]); }
  exit(0);
}
p = pose_point(row,"b",[2.0,3.0,4.0]);
assert(p[0]==3.0 && p[1]==5.0 && p[2]==7.0);
# 90 degrees around Z, deliberately non-unit: normalize without changing orientation.
row["b.qw"] = sqrt(2.0); row["b.qz"] = sqrt(2.0);
p = pose_point(row,"b",[2.0,0.0,0.0]);
assert(abs(p[0]-1.0)<0.000000001 && abs(p[1]-4.0)<0.000000001 && abs(p[2]-3.0)<0.000000001);
# 90 degrees around Y: local +Z becomes world +X (not a reflected rotation).
row["b.qw"]=sqrt(0.5); row["b.qz"]=0.0; row["b.qy"]=sqrt(0.5);
p=pose_point(row,"b",[0.0,0.0,2.0]);
assert(abs(p[0]-3.0)<0.000000001 && abs(p[1]-2.0)<0.000000001 && abs(p[2]-3.0)<0.000000001);
mkdir("build/examples");
pose_box_obj(row,"b",2.0,4.0,6.0,"build/examples/pose_bridge_test.obj");
lines=split(trim(read_file("build/examples/pose_bridge_test.obj")),"\n");
assert(lines.len()==21);
# Cylinder along local y, rotated 90 degrees about y (unchanged axis): caps at y = 2 -/+ 3, radius 1 about (1, *, 3).
row2 = {"c.x":1.0,"c.y":2.0,"c.z":3.0,"c.qw":sqrt(0.5),"c.qx":0.0,"c.qy":sqrt(0.5),"c.qz":0.0};
pose_cylinder_obj(row2,"c",1.0,6.0,8,"build/examples/pose_cyl_test.obj");
cl=split(trim(read_file("build/examples/pose_cyl_test.obj")),"\n");
assert(cl.len()==1+18+32);
for (ln in cl) {
  if (ln[0]=="v") {
    let f=split(ln," ");
    let dx=num(f[1])-1.0; let dz=num(f[3])-3.0; let y=num(f[2]);
    assert(abs(y-2.0)<0.000001 || abs(abs(y-2.0)-3.0)<0.000001);
    assert(abs(dx*dx+dz*dz-1.0)<0.000001 || abs(dx*dx+dz*dz)<0.000001);
  }
}
# Sphere: every vertex at distance r from the centre; hemispheres split the faces in half.
pose_sphere_obj(row2,"c",0.5,12,0,"build/examples/pose_sph_test.obj");
sl=split(trim(read_file("build/examples/pose_sph_test.obj")),"\n");
assert(sl.len()==1+7*12+6*12*2);
for (ln in sl) {
  if (ln[0]=="v") {
    let f=split(ln," ");
    let dx=num(f[1])-1.0; let dy=num(f[2])-2.0; let dz=num(f[3])-3.0;
    assert(abs(sqrt(dx*dx+dy*dy+dz*dz)-0.5)<0.000001);
  }
}
pose_sphere_obj(row2,"c",0.5,12,1,"build/examples/pose_sph_half.obj");
assert(split(trim(read_file("build/examples/pose_sph_half.obj")),"\n").len()==1+7*12+3*12*2);
println("pose bridge: translation, quaternion order/handedness, normalization, box/cylinder/sphere OBJ topology pass");
